<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView style="@style/Overline" android:text="Czwartek, 24 września" />
    <TextView style="@style/PageTitle" android:text="Dziś" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView style="@style/Chip" android:text="Plan: Szkoła" />
        <TextView style="@style/SmallText" android:text="2 z 5 wykonane" android:layout_marginStart="8dp" />
    </LinearLayout>
    <include android:id="@+id/task_morning" layout="@layout/item_task_done" android:layout_marginTop="12dp" />
    <include layout="@layout/item_task_done" android:id="@+id/task_school" />
    <include layout="@layout/item_task" android:id="@+id/task_lessons" />
    <include layout="@layout/item_task" android:id="@+id/task_english" />
    <include layout="@layout/item_task" android:id="@+id/task_training" />
</LinearLayout>
