<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Anuluj" android:textColor="@color/green" android:textSize="8sp" android:layout_marginTop="16dp" />
    <TextView style="@style/PageTitle" android:text="Nowe zadanie" />
    <TextView style="@style/FieldLabel" android:text="Tytuł" />
    <EditText style="@style/Field" android:text="Nauka angielskiego" />
    <TextView style="@style/FieldLabel" android:text="Dzień" />
    <TextView style="@style/Field" android:text="Pn    Wt    Śr    Cz    Pt    So    Nd" />
    <TextView style="@style/FieldLabel" android:text="Od                         Do" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <EditText style="@style/Field" android:layout_width="0dp" android:layout_weight="1" android:text="16:00" />
        <EditText style="@style/Field" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="17:00" />
    </LinearLayout>
    <TextView style="@style/FieldLabel" android:text="Kolor" />
    <TextView style="@style/Field" android:text="●   ●   ●   ◉" android:textColor="@color/green" />
    <TextView style="@style/FieldLabel" android:text="Przypomnienie" />
    <TextView style="@style/Field" android:text="10 minut przed" />
    <TextView style="@style/FieldLabel" android:text="Notatka" />
    <EditText style="@style/Field" android:minHeight="52dp" android:gravity="top" android:text="Powtórka słówek z rozdziału 4" />
    <Button android:id="@+id/save_task" style="@style/GreenButton" android:layout_width="match_parent" android:text="Zapisz zadanie" android:layout_marginTop="14dp" />
</LinearLayout>
