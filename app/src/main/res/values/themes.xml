<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Rytm" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Rytm" parent="Base.Theme.Rytm" />
    <style name="NavItem"><item name="android:layout_width">0dp</item><item name="android:layout_height">match_parent</item><item name="android:layout_weight">1</item><item name="android:gravity">center</item><item name="android:textSize">8sp</item><item name="android:textColor">@color/muted</item></style>
    <style name="TopLabel"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:textSize">14sp</item><item name="android:textColor">@color/muted</item></style>
    <style name="TopActions"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">9sp</item><item name="android:textColor">@color/muted</item></style>
    <style name="Overline"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">8sp</item><item name="android:textColor">@color/muted</item><item name="android:layout_marginTop">16dp</item></style>
    <style name="PageTitle"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">25sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/ink</item><item name="android:layout_marginTop">4dp</item><item name="android:layout_marginBottom">4dp</item></style>
    <style name="SmallText"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">7sp</item><item name="android:textColor">@color/muted</item></style>
    <style name="Chip"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">18dp</item><item name="android:paddingStart">8dp</item><item name="android:paddingEnd">8dp</item><item name="android:gravity">center</item><item name="android:textSize">7sp</item><item name="android:textColor">@android:color/white</item><item name="android:background">@drawable/bg_green_pill</item></style>
    <style name="TaskTitle"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">9sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/ink</item></style>
    <style name="TaskTime"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">6sp</item><item name="android:textColor">@color/muted</item></style>
    <style name="FieldLabel"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">7sp</item><item name="android:textColor">@color/muted</item><item name="android:layout_marginTop">10dp</item></style>
    <style name="Field"><item name="android:layout_width">match_parent</item><item name="android:layout_height">36dp</item><item name="android:textSize">8sp</item><item name="android:textColor">@color/muted</item><item name="android:background">@drawable/bg_field</item><item name="android:padding">8dp</item></style>
    <style name="GreenButton" parent="@android:style/Widget.Material.Button"><item name="android:textColor">@android:color/white</item><item name="android:textSize">8sp</item><item name="android:background">@drawable/bg_green_button</item></style>
    <style name="OutlineButton" parent="@android:style/Widget.Material.Button"><item name="android:textColor">@color/green</item><item name="android:textSize">8sp</item></style>
</resources>